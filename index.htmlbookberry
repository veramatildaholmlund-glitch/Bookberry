<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bookberry</title>

  <style>
    body {
      margin: 0;
      font-family: Georgia, serif;
      background: #fffaf2;
      color: #3b2b2b;
      text-align: center;
    }

    header {
      padding: 30px 20px;
      border-bottom: 1px solid #eadfd2;
    }

    h1 {
      font-size: 42px;
      margin: 10px 0;
    }

    .tagline {
      font-size: 18px;
      color: #806b6b;
    }

    .hero {
      padding: 80px 20px;
    }

    .hero h2 {
      font-size: 34px;
      margin-bottom: 15px;
    }

    .hero p {
      font-size: 18px;
      margin-bottom: 35px;
    }

    button {
      background: #d98f9c;
      color: white;
      border: none;
      padding: 15px 30px;
      border-radius: 30px;
      font-size: 18px;
      cursor: pointer;
    }

    button:hover {
      background: #c97887;
    }
  </style>
</head>

<body>

  <header>
    <h1>🍓 Bookberry</h1>
    <div class="tagline">A little package for your next story.</div>
  </header>

  <main class="hero">
    <h2>Find your next favorite book 📚</h2>
    <p>Choose your book, your style, and a few little surprises.</p>

    <button onclick="alert('Bookberry coming soon! 🍓')">
      Build your Bookberry
    </button>
  </main>

</body>
</html>
